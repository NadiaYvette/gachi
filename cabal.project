packages:
  packages/*/

with-compiler: ghc-9.14.1
write-ghc-environment-files: always
allow-newer: *
allow-newer: persistent:template-haskell, dhall:template-haskell, dhall:time
constraints: any.aeson ==2.2.5.1

package *
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  haddock-options: -w

source-repository-package
  type: git
  location: https://github.com/dhall-lang/dhall-haskell
  tag: 45c000f730b846b1e66fe6fa8e95854776641aee
  subdir: dhall

source-repository-package
  type: git
  location: https://github.com/NadiaYvette/polytropos
  tag: 4ffefe40de52ef72c626f811c6dd3fb147a6ba1b
  subdir: packages/polytropos-core

source-repository-package
  type: git
  location: https://github.com/NadiaYvette/polytropos
  tag: 4ffefe40de52ef72c626f811c6dd3fb147a6ba1b
  subdir: packages/polytropos-plugin

source-repository-package
